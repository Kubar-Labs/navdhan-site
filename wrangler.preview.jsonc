{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kubar-labs-navdhan-preview",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "APPLY_RATE_LIMITER_DO", "class_name": "ApplyRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ApplyRateLimiter"] }
  ],
  "ratelimits": [
    {
      "name": "APPLY_SESSION_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "APPLY_WRITE_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "APPLY_UPLOAD_RATE_LIMITER",
      "namespace_id": "2003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "APPLY_READ_RATE_LIMITER",
      "namespace_id": "2004",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
