# Copy to .env and fill in. All three are REQUIRED — there are no built-in
# defaults, so a missing value fails at startup/build instead of silently
# pointing the app at the wrong backend.

# ── Backend ───────────────────────────────────────────────────────────────
# Dev server only: `vite` proxies /api → this URL. Not read by `vite build`.
VITE_BACKEND_URL=http://localhost:8000

# API base URL the app calls.
#  • Local dev: keep this RELATIVE so it goes through the proxy above:
#       /api/v1/verify
#  • Production (portal embedded on the site, no proxy): set the ABSOLUTE URL
#    of your deployed backend, e.g.
#       https://kuber-verification-xxxxxx-as.a.run.app/api/v1/verify
#    (must match the backend's API_PREFIX, and the site origin must be in the
#     backend's ALLOWED_ORIGINS CORS whitelist).
VITE_API_BASE_URL=/api/v1/verify

# Dev server port. Dev only — `vite build` does not read it, and the
# container's nginx port comes from the Dockerfile's own PORT.
PORT=3000
