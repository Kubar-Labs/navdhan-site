# nginx:alpine auto-runs envsubst on this file at container start,
# replacing ${PORT} and ${BACKEND_URL} with the values in the environment.

server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Bank statement PDFs go through the proxy → allow large bodies.
    client_max_body_size 25m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml text/javascript image/svg+xml;

    # /api/** → backend Cloud Run service (same project, asia-south1).
    # Browser only ever sees the frontend origin, so no CORS preflight cost.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # Match backend timeout (Perfios BSA analysis can take minutes).
        proxy_read_timeout    900s;
        proxy_send_timeout    900s;
        proxy_connect_timeout 60s;
    }

    # Long-cache static assets (Vite already fingerprints filenames).
    location ~* \.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # SPA fallback — any unmatched route returns index.html so React Router works.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
