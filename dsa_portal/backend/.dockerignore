# Keep the build context small + never bake secrets / dev tools into the image.

# Secrets — must NOT enter the image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local-dev tools
cloud-sql-proxy
cloud-sql-proxy.exe

# Editor/OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# Misc
*.log
*_response.json
