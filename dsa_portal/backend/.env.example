# Template for dsa_portal/backend/.env — copy to .env and fill in real values.
# Never commit a filled-in .env; .dockerignore also keeps it out of the image.
# Loaded by collection_app.py via python-dotenv with override=False, so real
# environment variables (Cloud Run secrets, docker -e) win over this file.

# ── App ──────────────────────────────────────────────────────────────────────
# APP_ENV and ENV are the same setting under two names; APP_ENV wins when both
# are set. Defaults to dev.
APP_ENV=dev

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# Defaults to INFO. An unrecognised value falls back to INFO with a warning
# rather than killing the process.
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────────────
# Bind address and port. Defaults: 0.0.0.0 and 8000. Cloud Run injects PORT
# (usually 8080) and the Dockerfile honours it, so leave PORT unset there.
# Do NOT set HOST=127.0.0.1 for a deployed container — the platform's health
# checks cannot reach a loopback-bound process.
HOST=0.0.0.0
PORT=8000

# Comma-separated CORS origins, or * for any. Defaults to *.
# Note this is not the access control: the browser talks to Next, and Next
# calls this service server-side, so CORS is never evaluated on the real path.
# Cookies are not used (the session digest is a custom header), so credentials
# are disabled — which is also what makes * valid here.
ALLOWED_ORIGINS=*

# ── Database ─────────────────────────────────────────────────────────────────
# Either set DATABASE_URL outright, or leave it empty and supply the DB_* parts
# below. DATABASE_URL wins when both are present. There is no built-in default:
# a hard-coded local DSN would let a deployed container start and silently dial
# its own loopback instead of Cloud SQL, so a missing value fails at boot.
#
#   Local dev (project-local PG18 cluster, trust auth, HANDOFF section 1):
#     postgresql+asyncpg://postgres@127.0.0.1:55432/postgres
#   Cloud SQL over the proxy:
#     postgresql+asyncpg://<role>:<password>@127.0.0.1:5432/<database>
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:55432/postgres

# Parts-based alternative. DB_HOST may be a hostname/IP, or a Cloud SQL unix
# socket directory (/cloudsql/<project>:<region>:<instance>), in which case
# DB_PORT is ignored. DB_PASSWORD comes from a secret store — never inline it.
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# ── Encryption ───────────────────────────────────────────────────────────────
# Both required — the app refuses to start without them.
# 32-byte keys, base64-encoded. Generate each with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Rotating ENCRYPTION_KEY makes existing encrypted rows unreadable; rotating
# LOOKUP_HMAC_KEY orphans existing lookup hashes.
# In deployed environments inject from Secret Manager, e.g.
#   --set-secrets=ENCRYPTION_KEY=encryption-key:latest
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
LOOKUP_HMAC_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ── GCP / document storage ───────────────────────────────────────────────────
# Uploaded PDFs go to this bucket. Everything else lives in Postgres.
# Staging and production must use separate buckets, both separate from the
# unrelated inframan-* buckets (gcp.md step 8).
GCS_BUCKET=REPLACE_WITH_BUCKET_NAME

# Read by the google-cloud-storage client, not by our code, when resolving the
# default project.
GOOGLE_CLOUD_PROJECT=kubardevops

# Leave UNSET on Cloud Run — the attached service account supplies credentials,
# and a key file inside an image is a credential-leak path. Set it only for
# local work against real GCS, pointing at your own ADC file from
# `gcloud auth application-default login`. Never commit a machine-specific path.
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Optional ─────────────────────────────────────────────────────────────────
# Test-database overrides, read by tests/db_test_support.py only. Defaults
# target navdhan_test on the local cluster; the guard there refuses any name
# that is the dev database or lacks a _test suffix.
# NAVDHAN_TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:55432/navdhan_test
# NAVDHAN_TEST_PG_DSN=postgresql://postgres@127.0.0.1:55432/navdhan_test
# NAVDHAN_TEST_PSQL_PATH=
