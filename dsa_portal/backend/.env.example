# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev                           # dev | prod — picks kuber_dev vs kuber DB + bucket

# ── Perfios ──────────────────────────────────────────────────────────────────
PERFIOS_USERNAME=your_portal_login_username
PERFIOS_PASSWORD=your_portal_login_password
PERFIOS_ORG_ID=Kubar_Labs_lIlSxV
# PERFIOS_ENV is no longer read — the backend always uses production (hub.perfios.ai).

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
API_VERSION=v1
ALLOWED_ORIGINS=*

# ── Database (via cloud-sql-proxy on 127.0.0.1:5432) ─────────────────────────
# Password is in Secret Manager: db-app-password. Fetch with:
#   gcloud secrets versions access latest --secret=db-app-password
DATABASE_URL=postgresql+asyncpg://kuber_app:YOUR_DB_PASSWORD@127.0.0.1:5432/kuber_dev

# ── GCP ──────────────────────────────────────────────────────────────────────
# Points libraries at the fresh ADC file (not the old saturnintech key).
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Amit\AppData\Roaming\gcloud\application_default_credentials.json
GOOGLE_CLOUD_PROJECT=kubar-protocol-main
GCS_BUCKET=kuber-kyc-dev              # kuber-kyc-prod when APP_ENV=prod

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte AES-256 key, base64-encoded. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# In prod: stored in Secret Manager as `encryption-key` and injected via
# Cloud Run --set-secrets=ENCRYPTION_KEY=encryption-key:latest
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
