# Template for the Next.js app — copy to .env.local and fill in.
# .env.local is gitignored; only this example file is tracked.
# Server-only values: these are read in route handlers and server components,
# never shipped to the browser (no NEXT_PUBLIC_ prefix).

# Base URL of the collection backend (dsa_portal/backend).
#   Local development: the uvicorn process
#     APPLY_BACKEND_BASE_URL=http://127.0.0.1:8000
#   Deployed: the backend's Cloud Run URL
#     APPLY_BACKEND_BASE_URL=https://<service>-<hash>-<region>.a.run.app
# Required — there is no default. A fallback to loopback would make a deployed
# Worker fetch itself instead of the backend.
APPLY_BACKEND_BASE_URL=http://127.0.0.1:8000

# Shared service credential sent only by the server-side Worker to the backend.
# Use a distinct 32-byte-or-longer random value per environment. Configure the
# same secret value as APPLY_SERVICE_TOKEN on the backend; never expose it via
# a NEXT_PUBLIC_ variable or commit a filled-in local env file.
APPLY_BACKEND_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
